# Copy this file to .env.local and replace the local secret as needed.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_a_unique_random_secret

# Route Academy API endpoints used by the app
NEXT_PUBLIC_API_URL=https://ecommerce.routemisr.com/api/v1
NEXT_PUBLIC_API_URL_V2=https://ecommerce.routemisr.com/api/v2
NEXT_PUBLIC_ENV=development

# Optional search engine verification tokens
GOOGLE_WEBMASTER=
BING_WEBMASTER=